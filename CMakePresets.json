{
  "version": 6,
  "configurePresets": [
    {
      "name": "dev",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/dev",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "TRAFFIC_BUILD_APP": "ON",
        "BUILD_TESTING": "ON"
      }
    },
    {
      "name": "headless",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/headless",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "TRAFFIC_BUILD_APP": "OFF",
        "BUILD_TESTING": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "dev", "configurePreset": "dev" },
    { "name": "headless", "configurePreset": "headless" }
  ],
  "testPresets": [
    { "name": "dev", "configurePreset": "dev" },
    { "name": "headless", "configurePreset": "headless" }
  ]
}
